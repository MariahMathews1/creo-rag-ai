DATABASE_URL=sqlite:///./data/creo_nc_post_assistant.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCUMENT_STORAGE_PATH=./data/documents
MAX_DOCUMENT_UPLOAD_MB=50
AI_PROVIDER=mock
EMBEDDING_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# Phase 10 translation AI. Modes: disabled, mock, azure_openai.
TRANSLATION_AI_PROVIDER=mock
POST_BUILDER_AI_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_AUTH_MODE=entra_id
# Optional fallback only. Prefer Microsoft Entra ID / managed identity.
AZURE_OPENAI_API_KEY=
TRANSLATION_AI_TIMEOUT_SECONDS=20
TRANSLATION_AI_MAX_RETRIES=2
DOCUMENT_CHUNK_SIZE=900
DOCUMENT_CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.30
ENABLE_RETRIEVAL_DEBUG=false

MAX_PROGRAM_SOURCE_UPLOAD_MB=25
ALIGNMENT_HIGH_CONFIDENCE=0.90
ALIGNMENT_MEDIUM_CONFIDENCE=0.70
ALIGNMENT_MIN_CONFIDENCE=0.45
ALIGNMENT_COORDINATE_TOLERANCE=0.001
ALIGNMENT_FEED_TOLERANCE_PERCENT=2.0
ALIGNMENT_SPINDLE_TOLERANCE_PERCENT=1.0
ALIGNMENT_CANDIDATE_WINDOW=20
ENABLE_ALIGNMENT_DEBUG=false

PROFILE_EXTRACTION_PROVIDER=mock
PROFILE_EXTRACTION_MODEL=
PROFILE_EXTRACTION_TOP_K=8
PROFILE_EXTRACTION_MIN_SCORE=0.25
PROFILE_EXTRACTION_HIGH_CONFIDENCE=0.90
PROFILE_EXTRACTION_MEDIUM_CONFIDENCE=0.70
PROFILE_EXTRACTION_MIN_RECOMMENDED_CONFIDENCE=0.45
ENABLE_PROFILE_EXTRACTION_DEBUG=false
VITE_API_BASE_URL=http://localhost:8000/api
